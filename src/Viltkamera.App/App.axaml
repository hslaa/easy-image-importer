<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Viltkamera.App.App"
             RequestedThemeVariant="Light">

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.png" ToolTipText="Viltkamera Import" Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Åpne" Click="OnOpenClicked" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Avslutt" Click="OnQuitClicked" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme />

        <!-- Large, calm type: the user is not a computer person. -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#5A6358" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#9A3412" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2E5634" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3C6E43" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#9A3412" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B4431A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="14" />
        </Style>
    </Application.Styles>
</Application>
