<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:review="using:EasyImageImporter.App.ViewModels.Review"
             x:Class="EasyImageImporter.App.Views.NamingView"
             x:DataType="review:NamingScreen">

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="32,20,32,14">
            <Button Command="{Binding BackCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconBack}" />
                    <TextBlock Text="Bildene" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" Margin="20,0" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Navn og tagger" />
                <TextBlock Classes="muted" Text="Gi hvert sted et navn. Det blir brukt på mappen og i filnavnene." />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <Button Classes="primary" Command="{Binding SaveCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon" Data="{StaticResource IconCheck}" />
                        <TextBlock Text="Lagre bildene" />
                    </StackPanel>
                </Button>
                <TextBlock Classes="small warning" Text="{Binding MissingText}" HorizontalAlignment="Right"
                           IsVisible="{Binding MissingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Places}" Margin="32,18,20,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="review:PlaceForm">
                        <Border Classes="card" Padding="24,20" Margin="0,0,0,16">
                            <Grid ColumnDefinitions="210,*" ColumnSpacing="28">
                                <!-- A few photos, so it's obvious which place this is. -->
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="heading" Text="{Binding Heading}" />
                                    <TextBlock Classes="small muted" Text="{Binding Details}" />
                                    <ItemsControl ItemsSource="{Binding Covers}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="review:LazyThumbnail">
                                                <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,6,6"
                                                        Background="{StaticResource PlaceholderBrush}" Height="68">
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Classes="strong" Text="Navn på stedet" />
                                    <TextBox Text="{Binding Title}" PlaceholderText="F.eks. Høgfjellåsen" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                IsVisible="{Binding RecognisedText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentBrush}"
                                              Width="18" Height="18" Stretch="Uniform" />
                                        <TextBlock Classes="small muted" Text="{Binding RecognisedText}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Classes="strong" Text="Beskrivelse" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                             PlaceholderText="Valgfritt, f.eks. «Revekadaver ved stien opp fra myra»" />

                                    <TextBlock Classes="strong" Text="Stikkord" Margin="0,12,0,0" />
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="review:TagChip">
                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="16" Padding="14,2,2,2" Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <TextBlock Classes="small" Text="{Binding Text}" VerticalAlignment="Center" />
                                                        <Button Classes="link" Padding="8,4" Command="{Binding RemoveCommand}"
                                                                ToolTip.Tip="Fjern stikkordet">
                                                            <Path Classes="icon" Data="{StaticResource IconClose}" Width="14" Height="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <AutoCompleteBox Text="{Binding NewTag}" ItemsSource="{Binding TagSuggestions}" Width="260"
                                                         FilterMode="StartsWith" MinimumPrefixLength="1"
                                                         PlaceholderText="F.eks. åte, vinter">
                                            <AutoCompleteBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}" />
                                            </AutoCompleteBox.KeyBindings>
                                        </AutoCompleteBox>
                                        <Button Content="Legg til" Command="{Binding AddTagCommand}" />
                                    </StackPanel>

                                    <TextBlock Classes="strong" Text="Dyr på bildene" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding AnimalsText}" />

                                    <TextBlock Classes="strong" Text="Mappenavn" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding FolderName}" />
                                    <WrapPanel>
                                        <Path Classes="icon" Data="{StaticResource IconFolder}" Stroke="{StaticResource MutedBrush}"
                                              Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" Margin="0,0,6,0" />
                                        <TextBlock Classes="caption muted" Text="{Binding FolderPreview}" VerticalAlignment="Center" />
                                        <Button Classes="link" FontSize="14" Content="Bruk forslaget" Margin="8,0,0,0"
                                                Command="{Binding UseSuggestedFolderCommand}" IsVisible="{Binding IsCustomFolder}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
